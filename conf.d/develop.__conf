    #     proxy_ssl_verify off;
    #     proxy_set_header Host im-dev.mlg.ru;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    # location ~* ^/api/(inc|reference)/ {
    #     # rewrite ^/api/(.*)$ /$1 break;  # Убираем /api из пути
    #     proxy_pass http://monolith-backend:9009;
    #     proxy_ssl_verify off;
    #     proxy_set_header Host im-dev.mlg.ru;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    # ✅ Затем все остальные API-запросы отправляются на локальный сервер
    # location /api/ {
    #     proxy_pass http://monolith-backend:9009;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    # ✅ Все остальные запросы идут на внешний сервер
    location / {
        proxy_pass https://10.80.41.42;
        proxy_ssl_verify off;
        proxy_set_header Host im-dev.mlg.ru;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
